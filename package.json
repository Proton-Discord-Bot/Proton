{
  "name": "proton-bot",
  "version": "2.0.0",
  "description": "Proton — a Discord server-management bot",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "bun --watch src/index.ts",
    "start": "bun src/index.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "bun test",
    "deploy": "bun scripts/deploy-commands.ts",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "discord.js": "^14.26.5",
    "drizzle-orm": "^0.36.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^5.6.0",
    "drizzle-kit": "^0.28.0",
    "eslint": "^9.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "prettier": "^3.3.0"
  }
}
