[Unit]
Description=Proton Discord bot
Documentation=https://github.com/Proton-Bot-Development/Proton
After=network-online.target
Wants=network-online.target

# Discord rate-limits gateway reconnects. If the bot crash-loops, stop trying after
# 5 attempts in 5 minutes rather than hammering the gateway and risking a ban.
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
User=proton
Group=proton

WorkingDirectory=/opt/proton
# __BUN__ is replaced with the absolute path to the bun binary by deploy/install.sh.
ExecStart=__BUN__ /opt/proton/src/index.ts

# Secrets live in a root-owned 0600 file; systemd reads it as root before dropping
# privileges, so the service user never needs access to it.
# Generate with: secretspec export --profile production --format dotenv
EnvironmentFile=/etc/proton/proton.env
# Bun writes its cache under $HOME, which ProtectHome= would otherwise make unavailable.
Environment=HOME=/var/lib/proton

# Creates and owns /var/lib/proton. Point DATABASE_PATH at a file inside it.
StateDirectory=proton
StateDirectoryMode=0750

Restart=on-failure
RestartSec=5s

# --- Sandboxing ---
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectProc=invisible
ProtectClock=yes
ProtectHostname=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RemoveIPC=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
UMask=0077

# Must stay 'no'. Bun's JavaScriptCore JIT allocates write-then-execute pages; turning
# this on makes the runtime abort on startup.
MemoryDenyWriteExecute=no

[Install]
WantedBy=multi-user.target
