# Environment file for the Proton systemd service.
#
# Install to /etc/proton/proton.env, owned by root, mode 0600. systemd reads it as root
# before dropping to the service user, so the bot's own user never needs access.
#
# The easiest way to produce a real one, from a checkout with your secrets configured:
#
#   secretspec export --profile production --format dotenv | sudo tee /etc/proton/proton.env
#   sudo chmod 600 /etc/proton/proton.env
#
# Note that systemd parses this file itself — it is not a shell script. Do not use
# command substitution, variable expansion, or `export`.

# Discord bot token. Required.
TOKEN=

# Discord application id, used to register slash commands. Required.
DISCORD_APPLICATION_ID=

# Absolute path to the SQLite database. Must be inside /var/lib/proton, which the unit
# creates via StateDirectory=. A relative path would resolve against the working
# directory and silently create a second, empty database.
DATABASE_PATH=/var/lib/proton/database.sqlite

# DISCORD_GUILD_ID is deliberately omitted. When it is absent, `bun run deploy` registers
# commands globally, which is what production wants. Setting it here would confine every
# command to a single guild.
